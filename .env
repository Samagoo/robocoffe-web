# Copy to .env  (copy .env.example .env)

# --- PostgreSQL ---
POSTGRES_USER=robocoffee
POSTGRES_PASSWORD=robocoffee
POSTGRES_DB=robocoffee
# Change if another PostgreSQL already uses 5432 on this PC
POSTGRES_HOST_PORT=5432

# --- Robot subsystem (main_real.py / servidor_simulado.py, native on Windows) ---
# From inside the backend container, the Windows host is host.docker.internal
ROBOT_HOST=host.docker.internal
ROBOT_PORT=9000

# --- Load cell over Bluetooth (read by scale_bridge/, native on Windows) ---
# Reserved: used from the scale-bridge phase on
SCALE_COM_PORT=COM5
SCALE_BAUD=9600
